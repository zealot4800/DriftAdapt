# Network interfaces created by the programmed U55C OpenNIC image.
DRIFTADAPT_TX_IFACE=enp1s0f0
DRIFTADAPT_RX_IFACE=enp1s0f1

# Alveo U55C PF0 BAR2 control aperture.
DRIFTADAPT_HARDWARE_TARGET=u55c
DRIFTADAPT_PCI_RESOURCE=/sys/bus/pci/devices/0000:01:00.0/resource2

# InfluxDB 1.x telemetry endpoint.
DRIFTADAPT_INFLUX_HOST=127.0.0.1
DRIFTADAPT_INFLUX_PORT=8086
DRIFTADAPT_INFLUX_DATABASE=INFL_DB
DRIFTADAPT_INFLUX_MEASUREMENT=basic_tcp

# Model paths should be absolute on the deployment host.
DRIFTADAPT_INITIAL_MODEL=/absolute/path/to/cic-ids2017-in-network-dnn.pt
DRIFTADAPT_LABELER_MODEL=/absolute/path/to/cic-ids2017-labeler-dnn.pt

# Defaults matching stimulation/configs/cic-ids2017.yaml.
DRIFTADAPT_WINDOW_SIZE=100
DRIFTADAPT_TRIGGER_THRESHOLD=0.20
DRIFTADAPT_TRAINING_EPOCHS=30
DRIFTADAPT_TRAINING_BATCH_SIZE=512
DRIFTADAPT_LEARNING_RATE=0.01
DRIFTADAPT_RANDOM_SEED=42
